<script>
// ─── GALLERY DATA ─────────────────────────────────────
const PIECES=[
  {cat:'military',title:'Infantry Company Portrait, 1917',price:'From $220',img:'https://picsum.photos/seed/ns-m1/400/500'},
  {cat:'military',title:'Civil War Officer, c.1863',price:'From $285',img:'https://picsum.photos/seed/ns-m2/400/500'},
  {cat:'military',title:'WWII Unit Portrait, 1944',price:'From $250',img:'https://picsum.photos/seed/ns-m3/400/500'},
  {cat:'maps',title:'Antique World Map, c.1680',price:'From $340',img:'https://picsum.photos/seed/ns-mp1/400/500'},
  {cat:'maps',title:'Historic American Map, 1820',price:'From $195',img:'https://picsum.photos/seed/ns-mp2/400/500'},
  {cat:'states',title:'Historic Alabama, 1890s',price:'From $165',img:'https://picsum.photos/seed/ns-st1/400/500'},
  {cat:'states',title:'Georgia City Scene, 1910',price:'From $185',img:'https://picsum.photos/seed/ns-st2/400/500'},
  {cat:'celestial',title:'Celestial Chart, c.1720',price:'From $310',img:'https://picsum.photos/seed/ns-cel/400/500'},
  {cat:'lake',title:'Southern Lakeside, 1940s',price:'From $145',img:'https://picsum.photos/seed/ns-lk1/400/500'},
];
const LABELS={military:'Historic Military',maps:'Maps & Charts',states:'Historic States',celestial:'Celestial',lake:'Southern Lake Art'};

function renderGallery(f){
  document.getElementById('gallery').innerHTML=PIECES.map(p=>`
    <div class="piece${f&&f!=='all'&&p.cat!==f?' hidden':''}" data-cat="${p.cat}">
      <div class="piece-img" style="background-image:url('${p.img}')"></div>
      <div class="piece-info">
        <span class="piece-cat">${LABELS[p.cat]||p.cat}</span>
        <div class="piece-title">${p.title}</div>
        <div class="piece-price">${p.price}</div>
        <span class="piece-cta">Inquire →</span>
      </div>
    </div>`).join('');
}

// ─── NAV SCROLL ───────────────────────────────────────
window.addEventListener('scroll',()=>{
  document.getElementById('nav').classList.toggle('scrolled',window.scrollY>60);
});

// ─── GALLERY FILTER ───────────────────────────────────
document.addEventListener('DOMContentLoaded',()=>{
  renderGallery('all');
  document.querySelectorAll('.pill').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.querySelectorAll('.pill').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      renderGallery(btn.dataset.f);
    });
  });
});

// ─── SMOOTH SCROLL UTIL ───────────────────────────────
function scroll2(id){document.getElementById(id)?.scrollIntoView({behavior:'smooth'})}

// ─── LOOKBOOK FORM ────────────────────────────────────
function submitLookbook(){
  const n=document.getElementById('lb-fn').value.trim();
  const e=document.getElementById('lb-em').value.trim();
  if(!n||!e){alert('Please enter your name and email.');return;}
  document.getElementById('lb-form-wrap').style.display='none';
  document.getElementById('lb-success').style.display='block';
}

// ─── CHAT ─────────────────────────────────────────────
let chatOpen=false;
const history=[];

const SYS=`You are The Archivist — the warm, knowledgeable AI sales advisor for Nostalgia Station, a premier dealer of professionally restored antique photographs and historical maps based in Auburn, Alabama, serving clients nationwide.

Collection includes:
• Historic Military Photographs (WWI, WWII, Civil War, Vietnam era)
• Antique World Maps (some dating to the 1500s)
• Historic U.S. State Photographs (late 1800s–1970s)
• Celestial Maps and Astrological Charts
• Historic France and Serbia photographs
• Southern Lake Art — pastoral American South lake scenes
• Historic American Regional Maps

Commercial clients: military bases, VA hospitals, airports, hotels, universities, historic sites, museums, libraries. Custom sizing and framing available. Ships nationwide.

Goals:
1. Understand what they need (type of space, subject, aesthetic)
2. Recommend the right category with a historical detail or two
3. For commercial clients: mention the portfolio PDF and offer to connect with David (owner/master restorer) personally
4. Capture name and email to send the portfolio or set up a consultation
5. Keep replies concise — 2–4 sentences max. This is a chat widget.

End any lead capture with: "I'll make sure David reaches out personally within 24 hours."`;

function toggleChat(){
  chatOpen=!chatOpen;
  document.getElementById('chat-panel').classList.toggle('open',chatOpen);
  if(chatOpen&&history.length===0){
    appendMsg('ai',"Welcome to Nostalgia Station. I'm The Archivist — I can help you find the perfect piece or explore our commercial installation options. What kind of space or subject are you interested in?");
  }
}

function openChat(){chatOpen=false;toggleChat()}

function appendMsg(role,text){
  const el=document.createElement('div');
  el.className=`msg ${role}`;el.textContent=text;
  const m=document.getElementById('chat-msgs');
  m.appendChild(el);m.scrollTop=m.scrollHeight;
  return el;
}

async function sendMsg(){
  const inp=document.getElementById('chat-in');
  const txt=inp.value.trim();if(!txt)return;
  inp.value='';
  appendMsg('user',txt);
  history.push({role:'user',content:txt});
  const thinking=appendMsg('thinking','Searching the archives…');
  try{
    const res=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        model:'claude-sonnet-4-6',
        max_tokens:1000,
        system:SYS,
        messages:history
      })
    });
    const d=await res.json();
    const reply=d.content?.[0]?.text||'Apologies — could you try again?';
    thinking.remove();
    appendMsg('ai',reply);
    history.push({role:'assistant',content:reply});
  }catch(err){
    thinking.remove();
    appendMsg('ai','My connection seems disrupted. Reach out directly at david@nostalgiastation.com — we respond within the hour.');
  }
}
</script>
